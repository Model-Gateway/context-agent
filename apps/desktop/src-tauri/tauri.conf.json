{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context",
  "version": "0.1.0",
  "identifier": "dev.contextagent.desktop.tauri",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Context",
        "width": 1180,
        "height": 780,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "dragDropEnabled": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost https://models.dev; frame-src 'self' asset: http://asset.localhost https://asset.localhost; script-src 'self'",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "macOS": { "minimumSystemVersion": "12.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRTcyOTMxRDdDNkFENTUKUldSVnJjYlhNU25uMzZ6cFJLLzFTMmxBVGVJSEc0eEZ1VWk3MVlJUngxbjM2WFk1cnlHZEpIMFUK",
      "endpoints": ["https://github.com/Model-Gateway/context-agent/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
